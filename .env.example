# Copy this file to .env and adjust values. The app loads .env from the
# project root at startup (config.py).

# Ollama API key. A dummy value is fine for the LOCAL daemon endpoint below;
# a real key from https://ollama.com/settings/keys is only needed if you
# point BASE_URL at https://ollama.com/v1 directly.
OLLAMA_API_KEY=ollama

# Ollama base URL - local daemon by default. The daemon transparently
# proxies ":cloud" models to Ollama's cloud service once `ollama signin`
# has been run on this machine.
BASE_URL=http://localhost:11434/v1

# Model to use - must exist on the Ollama server, e.g. `ollama pull llama3.1`
# for a local model or `ollama pull gemma4:cloud` for a cloud one.
OLLAMA_MODEL=gemma4:cloud

# Optional: PlatformIO upload port (auto-detected if left empty),
# e.g. COM5 on Windows or /dev/ttyACM0 on Linux.
PLATFORMIO_UPLOAD_PORT=

# ChromaDB backend: "local" (persistent ./chroma_db, works offline with the
# bundled sentence-transformers model) or "cloud" (Chroma Cloud).
RAG_BACKEND=local
# Required only for RAG_BACKEND=cloud:
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=

# MongoDB chat-log persistence: full driver connection string.
# When unset, the documentation chat runs stateless (client resends history).
# Example for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>
# MONGODB_DB=embedded_agent

# Optional tuning (defaults shown):
# API_HOST=0.0.0.0
# API_PORT=8000
# LLM_MAX_TOKENS=2500
# LLM_MAX_ATTEMPTS=3
# LLM_TIMEOUT_SEC=300
# RAG_TOP_K=5
